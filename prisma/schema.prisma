 status String @default("Draft")
 tissueBankProgramId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([tissueBankProgramId])
 linkedTissueLotId TissueLot @relation("TissueProcessing_tissueLotId", fields: [tissueLotId], references: [id], onDelete: Restrict)
 linkedTissueBankProgramId TissueBankProgram @relation("TissueProcessing_tissueBankProgramId", fields: [tissueBankProgramId], references: [id], onDelete: Restrict)
}

