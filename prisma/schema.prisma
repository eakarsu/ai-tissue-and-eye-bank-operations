 @@index([createdAt])
 @@index([tissueBankProgramId])
 linkedTissueDonorId TissueDonor @relation("TissueLot_tissueDonorId", fields: [tissueDonorId], references: [id], onDelete: Restrict)
 linkedTissueBankProgramId TissueBankProgram @relation("TissueLot_tissueBankProgramId", fields: [tissueBankProgramId], references: [id], onDelete: Restrict)
 inverseTissueProcessing_tissueLotId TissueProcessing[] @relation("TissueProcessing_tissueLotId")
 inverseTissueTest_tissueLotId TissueTest[] @relation("TissueTest_tissueLotId")
 inverseQuarantineReview_tissueLotId QuarantineReview[] @relation("QuarantineReview_tissueLotId")
 inverseTissueDistribution_tissueLotId TissueDistribution[] @relation("TissueDistribution_tissueLotId")
 inverseTissueAdverseEvent_tissueLotId TissueAdverseEvent[] @relation("TissueAdverseEvent_tissueLotId")
}

model TissueProcessing {
 id String @id @default(cuid())
